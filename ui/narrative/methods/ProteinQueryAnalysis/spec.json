{
  "ver": 1,
  "name": "ProteinQueryAnalysis",
  "label": "Protein Query Analysis",
  "tooltip": "Protein query analysis pipeline",
  "header": "Protein Query Analysis",
  "description": "Protein query analysis pipeline",
  "categories": ["annotation", "sequence analysis"],
  "icon": "protein",
  "screenshots": [],
  "contact": "help@kbase.us",
  "widgets": {
    "input": null,
    "output": "no-display"
  },
  "parameters": [
    {
      "id": "input_type",
      "optional": false,
      "advanced": false,
      "allow_multiple": false,
      "default_values": ["protein_input"],
      "field_type": "dropdown",
      "dropdown_options": {
        "options": [
          {"value": "protein_input", "display": "Protein Input"},
          {"value": "uniprot_ids", "display": "UniProt IDs"},
          {"value": "workspace_object", "display": "Workspace Object"}
        ]
      }
    },
    {
      "id": "protein_input",
      "optional": true,
      "advanced": false,
      "allow_multiple": false,
      "default_values": [""],
      "field_type": "text",
      "text_options": {
        "validate_as": "string"
      },
      "conditional": {
        "control_param": "input_type",
        "control_value": "protein_input"
      }
    },
    {
      "id": "uniprot_ids",
      "optional": true,
      "advanced": false,
      "allow_multiple": true,
      "default_values": [],
      "field_type": "text",
      "text_options": {
        "validate_as": "string"
      },
      "conditional": {
        "control_param": "input_type",
        "control_value": "uniprot_ids"
      }
    },
    {
      "id": "workspace_object",
      "optional": true,
      "advanced": false,
      "allow_multiple": false,
      "default_values": [""],
      "field_type": "text",
      "text_options": {
        "valid_ws_types": ["KBaseGenomes.Genome", "KBaseGenomes.GenomeSet", "KBaseGenomes.ProteinSequenceSet"],
        "validate_as": "workspace_object_name"
      },
      "conditional": {
        "control_param": "input_type",
        "control_value": "workspace_object"
      }
    },
    {
      "id": "analysis_name",
      "optional": false,
      "advanced": false,
      "allow_multiple": false,
      "default_values": [""],
      "field_type": "text",
      "text_options": {
        "is_output_name": true
      }
    }
  ],
  "job_id_output_field": "docker",
  "behavior": {
    "service-mapping": {
      "name": "kbase_protein_query_module",
      "method": "run_protein_query_analysis",
      "url": "",
      "input_mapping": [
        {
          "narrative_system_variable": "workspace",
          "target_property": "workspace_name"
        },
        {
          "input_parameter": "input_type",
          "target_property": "input_type"
        },
        {
          "input_parameter": "protein_input",
          "target_property": "protein_input"
        },
        {
          "input_parameter": "uniprot_ids",
          "target_property": "uniprot_ids"
        },
        {
          "input_parameter": "workspace_object",
          "target_property": "workspace_object",
          "target_type_transform": "resolved-ref"
        },
        {
          "input_parameter": "analysis_name",
          "target_property": "analysis_name"
        }
      ],
      "output_mapping": [
        {
          "service_method_output_path": [0, "analysis_result_ref"],
          "target_property": "analysis_result_ref"
        },
        {
          "service_method_output_path": [0, "job_id"],
          "target_property": "job_id"
        },
        {
          "narrative_system_variable": "workspace",
          "target_property": "workspace_name"
        }
      ]
    }
  }
}
