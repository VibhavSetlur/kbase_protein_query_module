{
  "ver": 1,
  "name": "ProteinQueryAnalysis",
  "label": "Protein Query Analysis",
  "tooltip": "Analyze protein sequences using advanced bioinformatics methods including embedding generation, similarity search, and network analysis",
  "header": "Protein Query Analysis",
  "description": "This app performs comprehensive protein analysis including sequence analysis, embedding generation, similarity search, family assignment, network analysis, and bioinformatics analysis.",
  "categories": ["annotation", "metagenomes", "sequence analysis"],
  "icon": "protein",
  "screenshots": [],
  "contact": "help@kbase.us",
  "widgets": {
    "input": null,
    "output": null
  },
  "parameters": [
    {
      "id": "input_proteins",
      "optional": false,
      "advanced": false,
      "allow_multiple": false,
      "default_values": [],
      "field_type": "text",
      "text_options": {
        "valid_ws_types": ["KBaseGenomes.Genome", "KBaseGenomes.ContigSet", "KBaseFBA.NewModel", "KBaseFBA.FBAModel"],
        "validate_as": "workspace_object_name",
        "is_output_name": false
      },
      "ui_name": "Input Proteins",
      "short_hint": "Protein sequences to analyze (FASTA file, workspace object, or direct input)",
      "description": "Protein sequences to analyze. Can be provided as a FASTA file, workspace object reference, or direct sequence input.",
      "allowed_types": ["string"]
    },
    {
      "id": "analysis_type",
      "optional": true,
      "advanced": false,
      "allow_multiple": false,
      "default_values": ["comprehensive"],
      "field_type": "dropdown",
      "dropdown_options": {
        "options": [
          {"value": "comprehensive", "display": "Comprehensive Analysis"},
          {"value": "sequence_only", "display": "Sequence Analysis Only"},
          {"value": "similarity_only", "display": "Similarity Search Only"},
          {"value": "network_only", "display": "Network Analysis Only"}
        ]
      },
      "ui_name": "Analysis Type",
      "short_hint": "Type of analysis to perform",
      "description": "Select the type of analysis to perform on the input proteins.",
      "allowed_types": ["string"]
    },
    {
      "id": "enabled_stages",
      "optional": true,
      "advanced": true,
      "allow_multiple": true,
      "default_values": ["input_validation", "data_extraction", "embedding_generation", "family_assignment", "similarity_search", "sequence_analysis", "network_analysis", "bioinformatics_analysis", "report_generation", "visualization", "data_export"],
      "field_type": "dropdown",
      "dropdown_options": {
        "options": [
          {"value": "input_validation", "display": "Input Validation"},
          {"value": "data_extraction", "display": "Data Extraction"},
          {"value": "embedding_generation", "display": "Embedding Generation"},
          {"value": "family_assignment", "display": "Family Assignment"},
          {"value": "similarity_search", "display": "Similarity Search"},
          {"value": "sequence_analysis", "display": "Sequence Analysis"},
          {"value": "network_analysis", "display": "Network Analysis"},
          {"value": "bioinformatics_analysis", "display": "Bioinformatics Analysis"},
          {"value": "report_generation", "display": "Report Generation"},
          {"value": "visualization", "display": "Visualization"},
          {"value": "data_export", "display": "Data Export"}
        ]
      },
      "ui_name": "Enabled Stages",
      "short_hint": "Pipeline stages to enable",
      "description": "Select which pipeline stages to enable for the analysis.",
      "allowed_types": ["string"]
    },
    {
      "id": "stop_after_stage",
      "optional": true,
      "advanced": true,
      "allow_multiple": false,
      "default_values": [],
      "field_type": "dropdown",
      "dropdown_options": {
        "options": [
          {"value": "input_validation", "display": "Stop after Input Validation"},
          {"value": "data_extraction", "display": "Stop after Data Extraction"},
          {"value": "embedding_generation", "display": "Stop after Embedding Generation"},
          {"value": "family_assignment", "display": "Stop after Family Assignment"},
          {"value": "similarity_search", "display": "Stop after Similarity Search"},
          {"value": "sequence_analysis", "display": "Stop after Sequence Analysis"},
          {"value": "network_analysis", "display": "Stop after Network Analysis"},
          {"value": "bioinformatics_analysis", "display": "Stop after Bioinformatics Analysis"},
          {"value": "report_generation", "display": "Stop after Report Generation"},
          {"value": "visualization", "display": "Stop after Visualization"},
          {"value": "data_export", "display": "Stop after Data Export"}
        ]
      },
      "ui_name": "Stop After Stage",
      "short_hint": "Stop pipeline after this stage",
      "description": "Stop the pipeline execution after the specified stage (for debugging or partial analysis).",
      "allowed_types": ["string"]
    },
    {
      "id": "similarity_threshold",
      "optional": true,
      "advanced": true,
      "allow_multiple": false,
      "default_values": [0.8],
      "field_type": "float",
      "text_options": {
        "min_float": 0.0,
        "max_float": 1.0,
        "validate_as": "float"
      },
      "ui_name": "Similarity Threshold",
      "short_hint": "Minimum similarity score for protein matches",
      "description": "Minimum similarity score (0.0-1.0) required for proteins to be considered similar.",
      "allowed_types": ["float"]
    },
    {
      "id": "max_similar_proteins",
      "optional": true,
      "advanced": true,
      "allow_multiple": false,
      "default_values": [100],
      "field_type": "int",
      "text_options": {
        "min_int": 1,
        "max_int": 1000,
        "validate_as": "int"
      },
      "ui_name": "Max Similar Proteins",
      "short_hint": "Maximum number of similar proteins to return",
      "description": "Maximum number of similar proteins to return for each query protein.",
      "allowed_types": ["int"]
    },
    {
      "id": "embedding_model",
      "optional": true,
      "advanced": true,
      "allow_multiple": false,
      "default_values": ["esm2_t6_8M_UR50D"],
      "field_type": "dropdown",
      "dropdown_options": {
        "options": [
          {"value": "esm2_t6_8M_UR50D", "display": "ESM-2 (6B parameters)"},
          {"value": "esm2_t12_35M_UR50D", "display": "ESM-2 (12B parameters)"},
          {"value": "esm2_t30_150M_UR50D", "display": "ESM-2 (30B parameters)"}
        ]
      },
      "ui_name": "Embedding Model",
      "short_hint": "Protein language model for embedding generation",
      "description": "Select the protein language model to use for generating protein embeddings.",
      "allowed_types": ["string"]
    },
    {
      "id": "output_format",
      "optional": true,
      "advanced": true,
      "allow_multiple": false,
      "default_values": ["html"],
      "field_type": "dropdown",
      "dropdown_options": {
        "options": [
          {"value": "html", "display": "HTML Report"},
          {"value": "json", "display": "JSON Data"},
          {"value": "csv", "display": "CSV Data"},
          {"value": "all", "display": "All Formats"}
        ]
      },
      "ui_name": "Output Format",
      "short_hint": "Format for output files",
      "description": "Select the format for output files: HTML creates individual analysis reports plus summary; JSON provides complete pipeline results; CSV includes top proteins with metadata and input correlations; All generates comprehensive output directory.",
      "allowed_types": ["string"]
    },
    {
      "id": "output_report",
      "optional": false,
      "advanced": false,
      "allow_multiple": false,
      "default_values": [],
      "field_type": "text",
      "text_options": {
        "valid_ws_types": ["KBaseReport.Report"],
        "is_output_name": true
      },
      "ui_name": "Output Report Name",
      "short_hint": "Name for the output report object",
      "description": "Name for the output report object in the workspace.",
      "allowed_types": ["string"]
    },
    {
      "id": "output_data",
      "optional": true,
      "advanced": false,
      "allow_multiple": false,
      "default_values": [],
      "field_type": "text",
      "text_options": {
        "valid_ws_types": ["KBaseProteinQuery.ProteinQueryResults"],
        "is_output_name": true
      },
      "ui_name": "Output Data Name",
      "short_hint": "Name for the output data object",
      "description": "Name for the output data object in the workspace.",
      "allowed_types": ["string"]
    }
  ],
  "behavior": {
    "service-mapping": {
      "url": "",
      "name": "kbase_protein_query_module",
      "method": "run_protein_query_analysis",
      "input_mapping": [
        {
          "narrative_system_variable": "workspace",
          "target_property": "workspace_name"
        },
        {
          "input_parameter": "input_proteins",
          "target_property": "input_proteins"
        },
        {
          "input_parameter": "analysis_type",
          "target_property": "analysis_type"
        },
        {
          "input_parameter": "enabled_stages",
          "target_property": "enabled_stages"
        },
        {
          "input_parameter": "stop_after_stage",
          "target_property": "stop_after_stage"
        },
        {
          "input_parameter": "similarity_threshold",
          "target_property": "similarity_threshold"
        },
        {
          "input_parameter": "max_similar_proteins",
          "target_property": "max_similar_proteins"
        },
        {
          "input_parameter": "embedding_model",
          "target_property": "embedding_model"
        },
        {
          "input_parameter": "output_format",
          "target_property": "output_format"
        },
        {
          "input_parameter": "output_report",
          "target_property": "output_report_name"
        },
        {
          "input_parameter": "output_data",
          "target_property": "output_data_name"
        }
      ],
      "output_mapping": [
        {
          "service_method_output_path": [0,"report_name"],
          "target_property": "report_name"
        },
        {
          "service_method_output_path": [0,"report_ref"],
          "target_property": "report_ref"
        },
        {
          "service_method_output_path": [0,"analysis_result_ref"],
          "target_property": "analysis_result_ref"
        },
        {
          "service_method_output_path": [0,"output_directory"],
          "target_property": "output_directory"
        },
        {
          "service_method_output_path": [0,"html_report_files"],
          "target_property": "html_report_files"
        },
        {
          "service_method_output_path": [0,"exported_files"],
          "target_property": "exported_files"
        },
        {
          "service_method_output_path": [0,"stages_completed"],
          "target_property": "stages_completed"
        }
      ]
    }
  },
  "job_id_output_field": "docker"
}
