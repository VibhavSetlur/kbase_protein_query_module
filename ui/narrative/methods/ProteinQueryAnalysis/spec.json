{
  "ver": 1,
  "name": "ProteinQueryAnalysis",
  "label": "Protein Query Analysis",
  "tooltip": "Protein query analysis pipeline",
  "header": "Protein Query Analysis",
  "description": "Protein query analysis pipeline",
  "categories": ["protein"],
  "icon": "protein",
  "screenshots": [],
  "contact": "help@kbase.us",
  "widgets": {
    "input": null,
    "output": "no-display"
  },
  "parameters": [
    {
      "id": "input_type",
      "optional": false,
      "advanced": false,
      "allow_multiple": false,
      "default_values": ["protein_sequence"],
      "field_type": "dropdown",
        "dropdown_options": {
        "options": [
          {"value": "protein_sequence", "display": "Protein Sequence"},
          {"value": "uniprot_id", "display": "UniProt ID"}
        ]
      }
    },
    {
      "id": "protein_sequence",
      "optional": true,
      "advanced": false,
      "allow_multiple": false,
      "default_values": [""],
      "field_type": "text",
      "text_options": {
        "validate_as": "string"
      },
      "conditional": {
        "control_param": "input_type",
        "control_value": "protein_sequence"
      }
    },
    {
      "id": "uniprot_id",
      "optional": true,
      "advanced": false,
      "allow_multiple": true,
      "default_values": [],
      "field_type": "text",
      "text_options": {
        "validate_as": "string"
      },
      "conditional": {
        "control_param": "input_type",
        "control_value": "uniprot_id"
      }
    },
    {
      "id": "analysis_name",
      "optional": false,
      "advanced": false,
      "allow_multiple": false,
      "default_values": [""],
      "field_type": "text",
      "text_options": {
        "is_output_name": true
      }
    }
  ],
  "job_id_output_field": "docker",
  "behavior": {
    "service-mapping": {
      "name": "kbase_protein_query_module",
      "method": "run_protein_query_analysis",
      "url": "",
      "input_mapping": [
        {
          "narrative_system_variable": "workspace",
          "target_property": "workspace_name"
        },
        {
          "input_parameter": "input_type",
          "target_property": "input_type"
        },
        {
          "input_parameter": "protein_sequence",
          "target_property": "protein_sequence"
        },
        {
          "input_parameter": "uniprot_id",
          "target_property": "uniprot_id"
        },
        {
          "input_parameter": "analysis_name",
          "target_property": "analysis_name"
        }
      ],
      "output_mapping": [
        {
          "service_method_output_path": [0, "report_name"],
          "target_property": "report_name"
        },
        {
          "service_method_output_path": [0, "report_ref"],
          "target_property": "report_ref"
        }
      ]
    }
  }
}
