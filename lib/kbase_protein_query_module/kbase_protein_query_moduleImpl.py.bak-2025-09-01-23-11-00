                'model_name': model_name,
                'protein_id': input_id,
                'sequence_length': sequence_length,
                'embedding_dim': 1280,
                'input_source': 'direct_sequence',
                'pooling_method': 'mean',
                'generation_timestamp': time.time()
            }
            
            # Save embedding to workspace using KBUtilLib
