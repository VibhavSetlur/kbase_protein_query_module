    def check_protein_existence(self, ctx, params):
        """
        Check if protein exists in UniProt and optionally generate embedding.
        
        This method can be used as a standalone check or as the first step
        in the full protein analysis pipeline.
        """
        start_time = time.time()
        
        # Initialize output variable with default error state
        output = {
            'protein_id': 'unknown',
            'exists': False,
            'sequence': '',
            'sequence_length': 0,
            'message': 'Analysis not completed',
            'embedding_generated': False,
            'embedding_ref': '',
            'report_name': '',
            'report_ref': '',
            'input_parameters': params,
            'start_time': start_time
        }
        
        try:
            # Extract parameters
            protein_id = params.get('protein_id', '')
            generate_embedding = params.get('generate_embedding', False)
            embedding_model = params.get('embedding_model', 'esm2_t6_8M_UR50D')
            output_report = params.get('output_report', '')
            
            if not protein_id:
                raise ValueError("protein_id parameter is required")
            
            # Get workspace info
            workspace_name = ctx['provenance'][0]['ws_name'] if ctx.get('provenance') else 'unknown'
            
            # Initialize input parser
            from kbase_protein_query_module.src.utils.input_parser import InputParser
            input_parser = InputParser(workspace_client=self.kb_util.get_workspace_client())
            
            # Check if it's a valid UniProt ID
            if not input_parser._is_uniprot_id(protein_id):
                raise ValueError(f"Invalid UniProt ID format: {protein_id}")
            
            # Fetch protein from UniProt
            sequence = input_parser._fetch_uniprot_sequence(protein_id)
            
            if not sequence:
                # Protein not found in UniProt
                output = {
                    'protein_id': protein_id,
                    'exists': False,
                    'sequence': '',
                    'sequence_length': 0,
                    'message': f'Protein {protein_id} not found in UniProt database',
                    'embedding_generated': False,
                    'embedding_ref': '',
                    'report_name': '',
                    'report_ref': '',
                    'input_parameters': params,
                    'start_time': start_time
                }
            else:
                # Protein exists
                protein_record = input_parser.ProteinRecord(
                    protein_id=protein_id,
                    source='UniProt',
                    sequence=sequence,
                    metadata={'uniprot_id': protein_id}
                )
                
                # Generate embedding if requested
                embedding_ref = ''
                embedding_generated = False
                
                if generate_embedding:
                    try:
                        # Setup output directory
                        output_dir = self._setup_kbase_output_directory(workspace_name)
                        
                        # Generate embedding
                        from kbase_protein_query_module.src.processing.embeddings.generator import ProteinEmbeddingGenerator
                        generator = ProteinEmbeddingGenerator(model_name=embedding_model)
                        
                        embedding_result = generator.generate_embedding(protein_record.sequence)
                        
                        # Save embedding
                        embedding_path = os.path.join(output_dir, f"{protein_id}_embedding.h5")
                        generator.save_embeddings(
                            embeddings=[embedding_result['embedding']],
                            protein_ids=[protein_id],
                            output_path=embedding_path,
                            sequences_dict={protein_id: protein_record.sequence}
                        )
                        
                        # Create workspace object for embedding
                        embedding_data = {
                            'protein_id': protein_id,
                            'embedding': embedding_result['embedding'].tolist(),
                            'sequence': protein_record.sequence,
                            'model_name': embedding_model,
                            'metadata': {
                                'sequence_length': len(protein_record.sequence),
                                'embedding_dim': len(embedding_result['embedding']),
                                'source': 'UniProt'
                            }
                        }
                        
                        # Save to workspace
                        data_ref = self.kb_util.get_workspace_client().save_objects({
                            'workspace': workspace_name,
                            'objects': [{
                                'type': 'KBaseGenomes.ProteinSequenceSet',
                                'data': {
                                    'sequences': [{
                                        'id': protein_id,
                                        'sequence': protein_record.sequence,
                                        'metadata': embedding_data['metadata']
                                    }],
                                    'embedding_data': embedding_data
                                },
                                'name': f"{protein_id}_embedding_data"
                            }]
                        })[0]
                        
                        embedding_ref = f"{data_ref[6]}/{data_ref[0]}/{data_ref[4]}"
                        embedding_generated = True
                        
                    except Exception as e:
                        logger.error(f"Failed to generate embedding for {protein_id}: {e}")
                        embedding_generated = False
                
                # Create report
                report_info = self._create_existence_report(
                    protein_id, protein_record, embedding_generated, 
                    embedding_ref, output_report, workspace_name
                )
                
                output = {
                    'protein_id': protein_id,
                    'exists': True,
                    'sequence': protein_record.sequence,
                    'sequence_length': len(protein_record.sequence),
                    'message': f'Protein {protein_id} found in UniProt database',
                    'embedding_generated': embedding_generated,
                    'embedding_ref': embedding_ref,
                    'report_name': report_info['name'],
                    'report_ref': report_info['ref'],
                    'input_parameters': params,
                    'start_time': start_time,
                    'protein_record': protein_record  # For pipeline integration
                }
            
        except Exception as e:
            logger.error(f"Protein existence check failed: {e}")
            # Ensure output is defined even in case of error
            if output is None:
                output = {
                    'protein_id': protein_id if 'protein_id' in locals() else 'unknown',
                    'exists': False,
                    'sequence': '',
                    'sequence_length': 0,
                    'message': f'Error during protein existence check: {str(e)}',
                    'embedding_generated': False,
                    'embedding_ref': '',
                    'report_name': '',
                    'report_ref': '',
                    'input_parameters': params,
                    'start_time': start_time
                }
            # Return error output instead of raising
            return [output]
        #END check_protein_existence

        # Ensure output is defined
        if 'output' not in locals():
            output = {
                'protein_id': 'unknown',
                'exists': False,
                'sequence': '',
                'sequence_length': 0,
                'message': 'Analysis not completed',
                'embedding_generated': False,
                'embedding_ref': '',
                'report_name': '',
                'report_ref': '',
                'input_parameters': params,
                'start_time': start_time
            }

        # Type checking and return
        if not isinstance(output, dict):
            raise ValueError('Method check_protein_existence return value ' +
                             'output is not type dict as required.')
        # return the results
        return [output]
    
    def _create_existence_report(self, protein_id, protein_record, embedding_generated, 
                               embedding_ref, output_report, workspace_name):
        """Create KBase report for protein existence check."""
        try:
            report_client = KBaseReport(self.callback_url)
            
            # Create report message
            message = f"""Protein Existence Check Results

Protein ID: {protein_id}
Status: Found in UniProt database
Sequence Length: {len(protein_record.sequence)} amino acids
Embedding Generated: {'Yes' if embedding_generated else 'No'}

Sequence Preview: {protein_record.sequence[:50]}...

This protein can be used as input for the full protein analysis pipeline."""

            # Create objects list
            objects_created = []
            if embedding_ref:
                objects_created.append({
                    'ref': embedding_ref,
                    'description': f'Embedding data for {protein_id}'
                })

            report_info = report_client.create_extended_report({
                'message': message,
                'objects_created': objects_created,
                'workspace_name': workspace_name,
                'report_object_name': output_report or f"{protein_id}_existence_check"
            })
            
            return report_info
            
        except Exception as e:
            logger.error(f"Failed to create existence report: {e}")
            return {
                'name': f"{protein_id}_existence_check",
                'ref': 'error_report_ref'
            }

    def generate_protein_embedding(self, ctx, params):
        """
