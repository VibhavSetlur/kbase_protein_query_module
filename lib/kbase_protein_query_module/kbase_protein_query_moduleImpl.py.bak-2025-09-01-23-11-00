        return [output]
    
    def _setup_kbase_output_directory(self, workspace_name: str) -> str:
        """
        Setup KBase-compliant output directory.
        
        Uses proper directory creation with os.makedirs and exist_ok=True
        as recommended for KBase modules.
        """
        import os
        import tempfile
        
        # Use KBase scratch directory if available, otherwise use temp
        base_dir = os.environ.get('SCRATCH_DIR', tempfile.gettempdir())
        
        # Create unique output directory
        import uuid
        run_id = str(uuid.uuid4())[:8]
        output_dir = os.path.join(base_dir, f"protein_query_analysis_{workspace_name}_{run_id}")
        
        # Create directory with proper error handling
        try:
            os.makedirs(output_dir, exist_ok=True)
            logger.info(f"Created output directory: {output_dir}")
        except Exception as e:
            logger.error(f"Failed to create output directory {output_dir}: {e}")
            # Fallback to temp directory
            output_dir = os.path.join(tempfile.gettempdir(), f"protein_query_analysis_{run_id}")
            os.makedirs(output_dir, exist_ok=True)
            logger.info(f"Using fallback output directory: {output_dir}")
        
        return output_dir
    
    def _parse_input_by_type(self, input_parser, input_type, input_proteins, 
                            uniprot_ids, fasta_file, workspace_object, direct_sequences):
        """
        Parse input based on the specified type.
        
        Args:
            input_parser: InputParser instance
            input_type: Type of input ('uniprot', 'fasta', 'workspace_object', etc.)
            input_proteins: General input proteins parameter
            uniprot_ids: UniProt identifiers
            fasta_file: FASTA file path
            workspace_object: Workspace object reference
            direct_sequences: Direct protein sequences
            
        Returns:
            List of ProteinRecord objects
        """
        protein_records = []
        
        try:
            if input_type == 'uniprot':
                # Handle UniProt IDs
                if uniprot_ids:
                    if isinstance(uniprot_ids, str):
                        uniprot_ids = [id.strip() for id in uniprot_ids.split(',')]
                    protein_records = input_parser.parse_input('Uniprot', uniprot_ids)
                elif input_proteins:
                    # Check if input_proteins contains UniProt IDs
                    if isinstance(input_proteins, str):
                        input_proteins = [id.strip() for id in input_proteins.split(',')]
                    protein_records = input_parser.parse_input('Uniprot', input_proteins)
            
            elif input_type == 'fasta':
                # Handle FASTA file
                if fasta_file:
                    protein_records = input_parser.parse_input('FASTA', fasta_file)
                elif input_proteins and (input_proteins.endswith('.fasta') or input_proteins.endswith('.fa')):
                    protein_records = input_parser.parse_input('FASTA', input_proteins)
            
            elif input_type == 'workspace_object':
                # Handle workspace object
                if workspace_object:
                    protein_records = input_parser.parse_input('WorkspaceObject', workspace_object)
                elif input_proteins and '/' in input_proteins:
                    protein_records = input_parser.parse_input('WorkspaceObject', input_proteins)
            
            elif input_type == 'direct_sequence':
                # Handle direct sequences
                if direct_sequences:
                    if isinstance(direct_sequences, str):
                        direct_sequences = [seq.strip() for seq in direct_sequences.split(',')]
                    protein_records = input_parser.parse_input('SingleProtein', direct_sequences)
                elif input_proteins:
                    # Check if input_proteins contains protein sequences
                    if isinstance(input_proteins, str):
                        input_proteins = [seq.strip() for seq in input_proteins.split(',')]
                    protein_records = input_parser.parse_input('SingleProtein', input_proteins)
            
            elif input_type == 'mixed':
                # Handle mixed input types
                mixed_input = []
                if uniprot_ids:
                    mixed_input.extend(uniprot_ids if isinstance(uniprot_ids, list) else [uniprot_ids])
                if direct_sequences:
                    mixed_input.extend(direct_sequences if isinstance(direct_sequences, list) else [direct_sequences])
                if input_proteins:
                    mixed_input.extend(input_proteins if isinstance(input_proteins, list) else [input_proteins])
                
                protein_records = input_parser.parse_input('MixedInput', mixed_input)
            
            else:
                # Auto-detect input type
                if input_proteins:
                    detected_type = input_parser.detect_input_type(input_proteins)
                    protein_records = input_parser.parse_input(detected_type, input_proteins)
        
        except Exception as e:
            logger.error(f"Error parsing input type {input_type}: {e}")
            raise
        
        return protein_records
    
    def _create_kbase_report(self, result, output_report, workspace_name, output_dir):
        """Create KBase report with proper file handling."""
        try:
            from kbase_protein_query_module.src.stages.output.file_organizer import FileOrganizer
            
            # Organize output files
            organizer = FileOrganizer(output_dir)
            
            # Add all pipeline results to organizer
            if hasattr(result, 'final_output') and result.final_output:
                for key, value in result.final_output.items():
                    if isinstance(value, str) and os.path.exists(value):
                        if value.endswith('.html'):
                            organizer.register_visualization(value, 'network')
                        elif value.endswith(('.csv', '.tsv', '.json', '.h5')):
                            organizer.register_data_file(value, 'analysis')
            
            # Create comprehensive pipeline summary
            summary_path = organizer.create_comprehensive_pipeline_summary(result)
            
            # Create report
            report_client = KBaseReport(self.callback_url)
            report_info = report_client.create_extended_report({
                'message': f'Protein Query Analysis completed successfully. Analyzed {len(result.stages_completed)} pipeline stages.',
                'objects_created': [],
                'workspace_name': workspace_name,
                'report_object_name': output_report,
                'file_links': [
                    {
                        'path': output_dir,
                        'name': 'protein_analysis_results.zip',
                        'label': 'Complete Analysis Results',
                        'description': 'All analysis outputs including raw data, visualizations, and metadata'
                    }
                ],
                'html_links': [
                    {
                        'path': summary_path,
                        'name': 'pipeline_summary.html',
                        'label': 'Pipeline Summary',
                        'description': 'Comprehensive analysis summary and file manifest'
                    }
                ]
            })
            
            return report_info
            
        except Exception as e:
            logger.error(f"Failed to create KBase report: {e}")
            # Fallback to simple report
            report_client = KBaseReport(self.callback_url)
            return report_client.create_extended_report({
                'message': f'Protein Query Analysis completed. {result.error_message if hasattr(result, "error_message") else "Analysis successful"}',
                'workspace_name': workspace_name,
                'report_object_name': output_report
            })
    
    def _create_output_data_object(self, result, output_data, workspace_name):
        """Create output data object in workspace."""
        try:
            # Create ProteinSequenceSet object with analysis results
            data_object = {
                'sequences': [],
                'analysis_results': result.final_output,
                'metadata': {
                    'analysis_type': 'protein_query_analysis',
                    'stages_completed': result.stages_completed,
                    'execution_time': getattr(result, 'execution_time', 0)
                }
            }
            
            # Add protein sequences if available
            if hasattr(result, 'final_output') and 'protein_records' in result.final_output:
                for record in result.final_output['protein_records']:
                    data_object['sequences'].append({
                        'id': record.protein_id,
                        'sequence': record.sequence,
                        'metadata': record.metadata
                    })
            
            # Save to workspace
            data_ref = self.kb_util.get_workspace_client().save_objects({
                'workspace': workspace_name,
                'objects': [{
                    'type': 'KBaseGenomes.ProteinSequenceSet',
                    'data': data_object,
                    'name': output_data
                }]
            })[0]
            
            return f"{data_ref[6]}/{data_ref[0]}/{data_ref[4]}"
            
        except Exception as e:
            logger.error(f"Failed to create output data object: {e}")
            return None

